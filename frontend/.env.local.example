# OpenAI — solo para análisis y chat (la transcripción va al backend Python)
OPENAI_API_KEY=sk-...

# local = backend Python con Whisper (gratis, no gasta créditos OpenAI)
TRANSCRIPTION_MODE=local

# Backend Python
# Local:    http://127.0.0.1:8000
# Producción (Render): https://verificacol-backend.onrender.com
BACKEND_URL=http://127.0.0.1:8000

# Upstash Redis — jobs async + SSE (producción)
# Crear DB gratis en https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Secreto compartido Vercel ↔ Render (opcional pero recomendado)
WORKER_SECRET=
